# End users do not need this file: set these two values in Vercel instead
#   Vercel -> your project -> Settings -> Environment Variables
# This file is for developers running the site locally: copy to .env and fill in.
#
# Both values are in Supabase -> Project Settings -> API Keys.

# Project URL, e.g. https://abcdxyz.supabase.co
VITE_SUPABASE_URL=

# Publishable key (starts with sb_publishable_) or the legacy anon key (starts with eyJ).
# Never use a secret / service_role key: the site refuses to start with one.
VITE_SUPABASE_ANON_KEY=
